#!/usr/bin/env python3

import click, os


@click.command()
@click.argument('fnames', nargs=-1)
@click.option('--rev', is_flag=True)
def fur(fnames, rev):
    for fname in fnames:
        dirn, base = os.path.split(fname)
        ext = ''
        if '.' in base:
            base, ext = base[:base.rfind('.')], base[base.rfind('.'):]

        # print('dirn', '"' + dirn + '"')
        # print('base', '"' + base + '"')
        # print('ext', '"' + ext + '"')

        groups = base.split('_')
        if not groups: continue

        if rev:
            groups = reversed(groups)
        else:
            groups = [groups[-1]] + groups[:-1]

        # new_fname = f'{dirn}/{"_".join(groups)}.{ext}'
        new_fname = dirn
        if new_fname: new_fname += '/'
        new_fname = new_fname + '_'.join(groups) + ext

        # print(f'mv {fname} {new_fname}'
        try:
            os.rename(fname, new_fname)
        except FileNotFoundError as e:
            print('FILE DOES\'T EXIST:', fname)
            return


if __name__ == '__main__':
    fur()
