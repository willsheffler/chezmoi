#!/usr/bin/env bash

echo "Terminating graphical applications..."
pkill -TERM brave
pkill -TERM sublime_text
pkill -f -TERM mattermost-desktop
pkill -TERM warp-terminal
pkill -TERM atuin

while pgrep -f 'brave-browser|sublime_text|mattermost-desktop|warp-terminal' > /dev/null; do
  sleep 0.5
  ps aux | grep -E 'brave-browser|sublime_text|mattermost-desktop|warp-terminal'
done
